# Docker / X86 deployment bind address
HOST=0.0.0.0
PORT=4173
DATA_DIR=/data
ZHONGCAO_DATA_DIR=/mnt/nvme0n1-4/AppData/zhongcao
DATABASE_POOL_MAX=5

# Required by the running app. Keep the real value only in the X86 .env file.
DATABASE_URL=

# Optional one-time migration connection. It is never used by npm start.
# MIGRATION_DATABASE_URL=

# Reserved for a later authentication phase; unused in the current test deployment.
# SESSION_SECRET=
